<!-- Admin: Delayed Tasks - Dark Fantasy RPG Theme -->
<div class="rpg-bg-particles">
  <div class="relative z-10">
    <!-- Page header -->
    <div class="text-center py-8">
      <h1 class="font-display text-3xl md:text-4xl font-bold text-gold-400 tracking-wider mb-3 text-shadow-glow">
        Admin: Delayed Tasks
      </h1>
      <p class="text-gray-400 text-sm max-w-lg mx-auto">
        Auto-refreshes every <%= @refresh_interval / 1000 %> seconds
      </p>
      <div class="rpg-divider max-w-xs mx-auto mt-4"></div>
    </div>

    <div class="rpg-card p-5 overflow-hidden">
      <div class="overflow-x-auto">
        <table class="min-w-full">
          <thead>
            <tr class="border-b border-dark-600/30">
              <th class="text-left text-xs text-gray-500 font-medium uppercase tracking-wider px-3 py-3">ID</th>
              <th class="text-left text-xs text-gray-500 font-medium uppercase tracking-wider px-3 py-3">Type</th>
              <th class="text-left text-xs text-gray-500 font-medium uppercase tracking-wider px-3 py-3">State</th>
              <th class="text-left text-xs text-gray-500 font-medium uppercase tracking-wider px-3 py-3">Scheduled</th>
              <th class="text-left text-xs text-gray-500 font-medium uppercase tracking-wider px-3 py-3">Execute</th>
              <th class="text-left text-xs text-gray-500 font-medium uppercase tracking-wider px-3 py-3">Completed</th>
              <th class="text-center text-xs text-gray-500 font-medium uppercase tracking-wider px-3 py-3">Attempts</th>
              <th class="text-left text-xs text-gray-500 font-medium uppercase tracking-wider px-3 py-3">Error</th>
              <th class="text-left text-xs text-gray-500 font-medium uppercase tracking-wider px-3 py-3">Actions</th>
            </tr>
          </thead>
          <tbody>
            <%= for task <- @tasks do %>
              <tr class={if task.state == "failed", do: "bg-crimson-900/10"}>
                <td class="px-3 py-3 text-xs font-mono max-w-[120px] truncate text-gray-400">
                  <%= task.id %>
                </td>
                <td class="px-3 py-3 text-gold-400 font-medium">
                  <%= task.type %>
                </td>
                <td class="px-3 py-3">
                  <span class={state_class(task.state)}>
                    <%= task.state %>
                  </span>
                </td>
                <td class="px-3 py-3 text-xs text-gray-500">
                  <%= task.scheduled_at || "-" %>
                </td>
                <td class="px-3 py-3 text-xs text-gray-500">
                  <%= task.execute_at || "-" %>
                </td>
                <td class="px-3 py-3 text-xs text-gray-500">
                  <%= task.completed_at || "-" %>
                </td>
                <td class="px-3 py-3 text-center text-gray-400">
                  <%= task.attempts %>/<%= task.metadata["max_attempts"] || 3 %>
                </td>
                <td class="px-3 py-3 text-xs max-w-[200px] truncate text-crimson-400">
                  <%= task.error || "-" %>
                </td>
                <td class="px-3 py-3">
                  <button
                    type="button"
                    phx-click="delete_task"
                    phx-value-id={task.id}
                    phx-disable-with="Deleting..."
                    class="text-crimson-400 hover:text-crimson-300 text-sm transition-colors"
                    data-confirm="Delete this task?"
                  >
                    Delete
                  </button>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <%= if Enum.empty?(@tasks) do %>
        <p class="text-gray-500 text-center py-8">No tasks found.</p>
      <% end %>
    </div>

    <div class="text-center mt-6">
      <a href={~p"/"} class="rpg-btn-secondary">
        Back to Home
      </a>
    </div>
  </div>
</div>