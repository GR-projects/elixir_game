<!-- Resend Confirmation Page - Dark Fantasy RPG Theme -->
<div class="min-h-[80vh] flex items-center justify-center rpg-bg-particles">
  <div class="relative z-10 w-full max-w-md mx-auto">
    <!-- Header section -->
    <div class="text-center mb-8">
      <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-gradient-to-br from-gold-500 to-gold-700 shadow-glow-gold-lg mb-6">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          class="w-8 h-8 text-dark-950"
        >
          <path
            d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </div>
      <h1 class="font-display text-3xl font-bold text-gold-400 tracking-wider mb-2 text-shadow-glow">
        Confirm Your Email
      </h1>
      <p class="text-gray-400 text-sm">
        Resend the confirmation email
      </p>
    </div>
    <!-- Resend form card -->
    <div class="rpg-card p-8">
      <.simple_form :let={f} for={%{}} action={~p"/resend-confirmation"} method="post">
        <.input field={f[:login]} label="Login" placeholder="Enter your login" />
        <:actions>
          <.button class="w-full rpg-btn">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 20 20"
              fill="currentColor"
              class="w-4 h-4 mr-2"
            >
              <path d="M10.894 2.553a1 1 0 00-1.788 0l-7 14a1 1 0 001.169 1.409l5-1.429A1 1 0 009 15.571V11a1 1 0 112 0v4.571a1 1 0 00.725.962l5 1.428a1 1 0 001.17-1.408l-7-14z" />
            </svg>
            Resend Confirmation
          </.button>
        </:actions>
      </.simple_form>
    </div>
    <!-- Back to login link -->
    <div class="text-center mt-6">
      <p class="text-gray-500 text-sm">
        Already confirmed?
        <a
          href={~p"/login"}
          class="text-gold-400 hover:text-gold-300 font-semibold transition-colors"
        >
          Log in
        </a>
      </p>
    </div>
  </div>
</div>
