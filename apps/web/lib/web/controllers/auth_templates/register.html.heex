<!-- Register Page - Dark Fantasy RPG Theme -->
<div class="min-h-[80vh] flex items-center justify-center rpg-bg-particles">
  <div class="relative z-10 w-full max-w-md mx-auto">
    <!-- Header section -->
    <div class="text-center mb-8">
      <!-- Logo mark -->
      <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-gradient-to-br from-arcane-500 to-arcane-700 shadow-glow-arcane-lg mb-6">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-8 h-8 text-white">
          <path d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.455 2.456L21.75 6l-1.036.259a3.375 3.375 0 00-2.455 2.456zM16.894 20.567L16.5 21.75l-.394-1.183a2.25 2.25 0 00-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 001.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 001.423 1.423l1.183.394-1.183.394a2.25 2.25 0 00-1.423 1.423z" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>
      <h1 class="font-display text-3xl font-bold text-arcane-300 tracking-wider mb-2">
        Begin Your Journey
      </h1>
      <p class="text-gray-400 text-sm max-w-sm mx-auto">
        Create your account and join a growing community of adventurers
      </p>
    </div>

    <!-- Register form card -->
    <div class="rpg-card p-8">
      <.simple_form :let={f} for={@changeset} action={~p"/register"}>
        <.input placeholder="Used to login into the game" field={f[:login]} label="Login" />
        <.input placeholder="Visible by other players" field={f[:name]} label="Username" />
        <.input type="email" field={f[:email]} label="Email" placeholder="your@email.com" />
        <.input field={f[:password]} type="password" label="Password" placeholder="Choose a strong password" />
        <:actions>
          <.button class="w-full rpg-btn bg-gradient-to-b from-arcane-500 to-arcane-700 border-arcane-400/50 shadow-glow-arcane hover:from-arcane-400 hover:to-arcane-600 hover:shadow-glow-arcane-lg text-white">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4 mr-2">
              <path d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z" />
            </svg>
            Create Account
          </.button>
        </:actions>
      </.simple_form>
    </div>

    <!-- Login link -->
    <div class="text-center mt-6">
      <p class="text-gray-500 text-sm">
        Already have an account?
        <a href={~p"/login"} class="text-arcane-400 hover:text-arcane-300 font-semibold transition-colors">
          Log in here
        </a>
      </p>
    </div>
  </div>
</div>
