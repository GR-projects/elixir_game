<!-- User Profile - Dark Fantasy RPG Theme -->
<div class="max-w-2xl mx-auto">
  <!-- Page header -->
  <div class="mb-8">
    <h1 class="rpg-title text-2xl mb-1">Adventurer Profile</h1>
    <div class="rpg-divider mt-3"></div>
  </div>

  <!-- Profile card -->
  <div class="rpg-card p-8">
    <div class="flex items-start gap-6">
      <!-- Avatar -->
      <div class="flex-shrink-0">
        <div class="w-20 h-20 rounded-xl ring-2 ring-gold-700/30 overflow-hidden shadow-glow-gold">
          <img
            src="/images/user_logo_compressed.png"
            class="w-full h-full object-cover"
            alt="User avatar"
          />
        </div>
      </div>

      <!-- Info -->
      <div class="flex-grow space-y-4">
        <div>
          <p class="text-xs font-display tracking-wider text-gold-500/70 uppercase mb-1">Username</p>
          <p class="text-xl font-display font-semibold text-gray-100 tracking-wide"><%= @user.name %></p>
        </div>

        <div class="rpg-divider"></div>

        <div>
          <p class="text-xs font-display tracking-wider text-gold-500/70 uppercase mb-1">Email</p>
          <p class="text-gray-300"><%= @user.email %></p>
        </div>
      </div>
    </div>
  </div>

  <!-- Quick links -->
  <div class="mt-6 flex gap-4">
    <a href={~p"/character"} class="rpg-btn-secondary flex-1 text-center">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4 mr-2 inline-block">
        <path d="M10 8a3 3 0 100-6 3 3 0 000 6zM3.465 14.493a1.23 1.23 0 00.41 1.412A9.957 9.957 0 0010 18c2.31 0 4.438-.784 6.131-2.1.43-.333.604-.903.408-1.41a7.002 7.002 0 00-13.074.003z" />
      </svg>
      Characters
    </a>
    <a href={~p"/equipment"} class="rpg-btn-secondary flex-1 text-center">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4 mr-2 inline-block">
        <path fill-rule="evenodd" d="M1 2.75A.75.75 0 011.75 2h16.5a.75.75 0 010 1.5H18v8.75A2.75 2.75 0 0115.25 15h-1.072l.798 3.06a.75.75 0 01-1.452.38L13.41 18H6.59l-.114.44a.75.75 0 01-1.452-.38L5.822 15H4.75A2.75 2.75 0 012 12.25V3.5h-.25A.75.75 0 011 2.75z" clip-rule="evenodd" />
      </svg>
      Equipment
    </a>
  </div>
</div>
