<!-- Main Dashboard - Dark Fantasy RPG Theme -->
<div class="rpg-bg-particles">
  <div class="relative z-10">
    <!-- Welcome banner -->
    <div class="text-center py-12">
      <h1 class="font-display text-4xl md:text-5xl font-bold text-gold-400 tracking-wider mb-4 text-shadow-glow">
        Welcome, Adventurer
      </h1>
      <p class="text-gray-400 text-lg max-w-lg mx-auto">
        Your quest awaits. Choose your path wisely.
      </p>
      <div class="rpg-divider max-w-xs mx-auto mt-6"></div>
    </div>

    <!-- Quick action cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mt-8 max-w-4xl mx-auto">
      <!-- Characters -->
      <a href={~p"/character"} class="rpg-card p-6 group transition-all duration-300 hover:-translate-y-1 block">
        <div class="flex items-center gap-4 mb-4">
          <div class="w-12 h-12 rounded-xl bg-gold-900/50 border border-gold-700/30 flex items-center justify-center group-hover:shadow-glow-gold transition-shadow">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-6 h-6 text-gold-400">
              <path fill-rule="evenodd" d="M7.5 6a4.5 4.5 0 119 0 4.5 4.5 0 01-9 0zM3.751 20.105a8.25 8.25 0 0116.498 0 .75.75 0 01-.437.695A18.683 18.683 0 0112 22.5c-2.786 0-5.433-.608-7.812-1.7a.75.75 0 01-.437-.695z" clip-rule="evenodd" />
            </svg>
          </div>
          <div>
            <h3 class="font-display text-lg font-semibold text-gold-400 tracking-wide">Characters</h3>
            <p class="text-xs text-gray-500">Manage your heroes</p>
          </div>
        </div>
        <p class="text-sm text-gray-400">View, create, and manage your characters. Level up and grow stronger.</p>
      </a>

      <!-- Equipment -->
      <a href={~p"/equipment"} class="rpg-card p-6 group transition-all duration-300 hover:-translate-y-1 block">
        <div class="flex items-center gap-4 mb-4">
          <div class="w-12 h-12 rounded-xl bg-arcane-900/50 border border-arcane-700/30 flex items-center justify-center group-hover:shadow-glow-arcane transition-shadow">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-6 h-6 text-arcane-400">
              <path d="M12 2.25a.75.75 0 01.75.75v2.25a.75.75 0 01-1.5 0V3a.75.75 0 01.75-.75zM7.5 12a4.5 4.5 0 119 0 4.5 4.5 0 01-9 0zM18.894 6.166a.75.75 0 00-1.06-1.06l-1.591 1.59a.75.75 0 101.06 1.061l1.591-1.59zM21.75 12a.75.75 0 01-.75.75h-2.25a.75.75 0 010-1.5H21a.75.75 0 01.75.75zM17.834 18.894a.75.75 0 001.06-1.06l-1.59-1.591a.75.75 0 10-1.061 1.06l1.59 1.591zM12 18a.75.75 0 01.75.75V21a.75.75 0 01-1.5 0v-2.25A.75.75 0 0112 18zM7.758 17.303a.75.75 0 00-1.061-1.06l-1.591 1.59a.75.75 0 001.06 1.061l1.591-1.59zM6 12a.75.75 0 01-.75.75H3a.75.75 0 010-1.5h2.25A.75.75 0 016 12zM6.697 7.757a.75.75 0 001.06-1.06l-1.59-1.591a.75.75 0 00-1.061 1.06l1.59 1.591z" />
            </svg>
          </div>
          <div>
            <h3 class="font-display text-lg font-semibold text-arcane-400 tracking-wide">Equipment</h3>
            <p class="text-xs text-gray-500">Gear & inventory</p>
          </div>
        </div>
        <p class="text-sm text-gray-400">Equip powerful gear and manage your inventory. Find legendary items.</p>
      </a>

      <!-- Battle (coming soon) -->
      <div class="rpg-card p-6 opacity-60 relative overflow-hidden">
        <div class="absolute top-3 right-3">
          <span class="rpg-badge text-[0.65rem]">Coming Soon</span>
        </div>
        <div class="flex items-center gap-4 mb-4">
          <div class="w-12 h-12 rounded-xl bg-crimson-900/50 border border-crimson-700/30 flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-6 h-6 text-crimson-400">
              <path fill-rule="evenodd" d="M12.963 2.286a.75.75 0 00-1.071-.136 9.742 9.742 0 00-3.539 6.177A7.547 7.547 0 016.648 6.61a.75.75 0 00-1.152.082A9 9 0 1015.68 4.534a7.46 7.46 0 01-2.717-2.248zM15.75 14.25a3.75 3.75 0 11-7.313-1.172c.628.465 1.35.81 2.133 1a5.99 5.99 0 011.925-3.545 3.75 3.75 0 013.255 3.717z" clip-rule="evenodd" />
            </svg>
          </div>
          <div>
            <h3 class="font-display text-lg font-semibold text-crimson-400 tracking-wide">Battle</h3>
            <p class="text-xs text-gray-500">Fight enemies</p>
          </div>
        </div>
        <p class="text-sm text-gray-400">Challenge fearsome foes and prove your worth in combat.</p>
      </div>
    </div>
  </div>
</div>
