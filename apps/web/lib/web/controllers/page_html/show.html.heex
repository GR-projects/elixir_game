<!-- Character Detail - Dark Fantasy RPG Theme -->
<div class="max-w-2xl mx-auto">
  <!-- Page header with back button -->
  <div class="mb-8">
    <div class="flex items-center gap-3 mb-4">
      <.link navigate={~p"/character"} class="p-1.5 rounded-lg text-gray-500 hover:text-gold-400 hover:bg-dark-700/50 transition-all">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-5 h-5">
          <path fill-rule="evenodd" d="M17 10a.75.75 0 01-.75.75H5.612l4.158 3.96a.75.75 0 11-1.04 1.08l-5.5-5.25a.75.75 0 010-1.08l5.5-5.25a.75.75 0 111.04 1.08L5.612 9.25H16.25A.75.75 0 0117 10z" clip-rule="evenodd" />
        </svg>
      </.link>
      <div>
        <h1 class="rpg-title text-2xl">Character Details</h1>
      </div>
    </div>
    <div class="rpg-divider"></div>
  </div>

  <!-- Character card -->
  <div class="rpg-card p-8">
    <div class="flex items-start gap-6">
      <!-- Character icon -->
      <div class={"w-20 h-20 rounded-xl border-2 flex items-center justify-center flex-shrink-0 class-#{String.downcase(to_string(@character.type))}"}>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-10 h-10">
          <path fill-rule="evenodd" d="M7.5 6a4.5 4.5 0 119 0 4.5 4.5 0 01-9 0zM3.751 20.105a8.25 8.25 0 0116.498 0 .75.75 0 01-.437.695A18.683 18.683 0 0112 22.5c-2.786 0-5.433-.608-7.812-1.7a.75.75 0 01-.437-.695z" clip-rule="evenodd" />
        </svg>
      </div>

      <!-- Character info -->
      <div class="flex-grow">
        <div class="flex items-center gap-3 mb-1">
          <h2 class="font-display text-2xl font-bold text-gray-100 tracking-wide">
            <%= @character.name %>
          </h2>
          <span class={"rpg-badge class-#{String.downcase(to_string(@character.type))}"}>
            <%= @character.type %>
          </span>
        </div>

        <div class="rpg-divider my-4"></div>

        <!-- Stats grid -->
        <div class="grid grid-cols-2 gap-4">
          <div class="rpg-panel p-4 rounded-lg">
            <p class="text-[0.65rem] font-display tracking-wider uppercase text-gold-500/70 mb-1">Level</p>
            <p class="text-2xl font-display font-bold text-gold-400"><%= @character.level %></p>
          </div>
          <div class="rpg-panel p-4 rounded-lg">
            <p class="text-[0.65rem] font-display tracking-wider uppercase text-arcane-400/70 mb-1">Experience</p>
            <p class="text-2xl font-display font-bold text-arcane-300"><%= @character.experience %> <span class="text-sm font-normal text-gray-500">XP</span></p>
          </div>
        </div>

        <!-- XP progress bar -->
        <div class="mt-4">
          <div class="flex items-center justify-between text-xs text-gray-500 mb-1">
            <span>Experience Progress</span>
            <span><%= @character.experience %> / <%= (@character.level + 1) * 100 %> XP</span>
          </div>
          <div class="h-2 bg-dark-700 rounded-full overflow-hidden">
            <div
              class="h-full bg-gradient-to-r from-arcane-600 to-arcane-400 rounded-full transition-all duration-500"
              style={"width: #{min(100, @character.experience / ((@character.level + 1) * 100) * 100)}%"}
            >
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Actions -->
  <div class="mt-6 flex gap-4 justify-end">
    <.link navigate={~p"/character"} class="rpg-btn-secondary">
      Back to Characters
    </.link>
    <form method="post" action={~p"/character/#{@character.id}"}>
      <input type="hidden" name="_method" value="delete" />
      <input type="hidden" name="_csrf_token" value={Plug.CSRFProtection.get_csrf_token()} />
      <button class="rpg-btn-danger" type="submit" data-confirm="Are you sure you want to delete this character? This action cannot be undone.">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4 mr-1.5">
          <path fill-rule="evenodd" d="M8.75 1A2.75 2.75 0 006 3.75v.443c-.795.077-1.584.176-2.365.298a.75.75 0 10.23 1.482l.149-.022.841 10.518A2.75 2.75 0 007.596 19h4.807a2.75 2.75 0 002.742-2.53l.841-10.519.149.023a.75.75 0 00.23-1.482A41.03 41.03 0 0014 4.193V3.75A2.75 2.75 0 0011.25 1h-2.5zM10 4c.84 0 1.673.025 2.5.075V3.75c0-.69-.56-1.25-1.25-1.25h-2.5c-.69 0-1.25.56-1.25 1.25v.325C8.327 4.025 9.16 4 10 4zM8.58 7.72a.75.75 0 00-1.5.06l.3 7.5a.75.75 0 101.5-.06l-.3-7.5zm4.34.06a.75.75 0 10-1.5-.06l-.3 7.5a.75.75 0 101.5.06l.3-7.5z" clip-rule="evenodd" />
        </svg>
        Delete Character
      </button>
    </form>
  </div>
</div>
